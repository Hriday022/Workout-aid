# Copy this file to .env for local development (never commit the real .env)
SECRET_KEY=replace-with-a-random-string
FLASK_ENV=development

# Leave unset to use local SQLite. Set to a Postgres URL in production.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional — if set, PDFs are parsed with Claude instead of the regex fallback.
# ANTHROPIC_API_KEY=sk-ant-...
